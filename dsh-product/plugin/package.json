  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./host.mjs", "./client": "./client.js", "./package.json": "./package.json" },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
