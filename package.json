{
  "name": "dsh-remote-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pi": "./pi.mjs",
    "pi-remote": "./pi-remote.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "tools:manifest": "node worker.mjs --manifest",
    "tools:check": "node worker.mjs --check-manifest",
    "setup:environment": "sh scripts/setup.sh environment",
    "setup:dsh": "sh scripts/setup.sh dsh",
    "test:platform": "python3 verify_platform.py",
    "release:check": "python3 scripts/check_release.py",
    "release:build": "python3 scripts/build_release.py"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@modelcontextprotocol/sdk": "1.26.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27"
  },
  "description": "A shared multi-machine tool environment for existing agents, with an optional DSH Web host",
  "license": "MIT"
}
